<odoo>

<odoo>
  <record id="res_config_settings_view_form_excel_export" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.excel.export</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app string="Excel Export" name="excel_export_settings">
          <block title="Excel Export Layout">
            <setting string="Custom Layout Models"
                     help="Select models that will use the branded header in Excel exports.">
              <field name="excel_export_model_ids"
                     widget="many2many_tags"
                     options="{'no_create': True}"/>
            </setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
</odoo>